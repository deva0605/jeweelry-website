# ══════════════════════════════════════════════════════
#  .env.example — copy to .env and fill in real values
#  NEVER commit the real .env file
# ══════════════════════════════════════════════════════

# Server
PORT=3001
NODE_ENV=development

# Private Jewelry Concierge integrations
UPI_ID=your-merchant-upi@ybl
BUSINESS_NAME="Ushhh.atelier"
WHATSAPP_TOKEN=your_meta_permanent_system_user_token
WHATSAPP_PHONE_ID=your_meta_phone_number_id

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=24h

# Cookie
COOKIE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Bcrypt — salt rounds (10-12 recommended; higher = slower but more secure)
BCRYPT_ROUNDS=12

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Account lockout — how many failed attempts before locking (default: 5)
MAX_LOGIN_ATTEMPTS=5
# Lock duration in minutes (default: 30)
LOCK_DURATION_MINUTES=30

# PostgreSQL — main database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jewellery_db
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_PG_PASSWORD
