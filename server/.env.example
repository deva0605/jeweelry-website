# ══════════════════════════════════════════════════════
#  .env.example — copy to .env and fill in real values
#  NEVER commit the real .env file
# ══════════════════════════════════════════════════════

# Server
PORT=3001
NODE_ENV=development

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=24h

# Cookie
COOKIE_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET

# Bcrypt — salt rounds (10-12 recommended; higher = slower but more secure)
BCRYPT_ROUNDS=12

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# Account lockout — how many failed attempts before locking (default: 5)
MAX_LOGIN_ATTEMPTS=5
# Lock duration in minutes (default: 30)
LOCK_DURATION_MINUTES=30

# PostgreSQL � required by /api/orders/checkout
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=jewellry
PG_USER=postgres
PG_PASSWORD=REPLACE_WITH_PG_PASSWORD
PG_SSL=false
